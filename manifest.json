{
  "manifest_version": 3,
  "name": "TestFiller – Form Autofill & Testing Tool",
  "description": "Generate unique, clearly identifiable test emails and fill active form fields.",
  "version": "1.0.1",
  "action": {
    "default_title": "TestFiller",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "commands": {
    "generate-email": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "Generate and copy a TestFiller test email"
    },
    "generate-and-fill": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Generate, copy, and fill a TestFiller test email"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "options_page": "src/ui/options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
